ring r=7,(y,t,b1,b2,b3,b4,b5,a1,a2,a3,a4,a5),dp;
option(redSB);
ideal I=(1*1*1*1+a1*b1*b1*a1+a2*b2*b2*a2+a3*b3*b3*a3+a4*b4*b4*a4+a5*b5*b5*a5)-2*t,(1*1*b1*a1+a1*b1*b2*a2+a2*b2*b3*a3+a3*b3*b4*a4+a4*b4*b5*a5+a5*b5*1*1)-1*t,(1*1*b2*a2+a1*b1*b3*a3+a2*b2*b4*a4+a3*b3*b5*a5+a4*b4*1*1+a5*b5*b1*a1)-1*t,(1*1*b3*a3+a1*b1*b4*a4+a2*b2*b5*a5+a3*b3*1*1+a4*b4*b1*a1+a5*b5*b2*a2)-1*t,(1*b1*b1*a2+a1*b2*b2*a3+a2*b3*b3*a4+a3*b4*b4*a5+a4*b5*b5*1+a5*1*1*a1),(1*b1*b2*a3+a1*b2*b3*a4+a2*b3*b4*a5+a3*b4*b5*1+a4*b5*1*a1+a5*1*b1*a2),(1*b1*b3*a4+a1*b2*b4*a5+a2*b3*b5*1+a3*b4*1*a1+a4*b5*b1*a2+a5*1*b2*a3),(1*b1*b4*a5+a1*b2*b5*1+a2*b3*1*a1+a3*b4*b1*a2+a4*b5*b2*a3+a5*1*b3*a4),(1*b1*b5*1+a1*b2*1*a1+a2*b3*b1*a2+a3*b4*b2*a3+a4*b5*b3*a4+a5*1*b4*a5),(1*b2*b2*a4+a1*b3*b3*a5+a2*b4*b4*1+a3*b5*b5*a1+a4*1*1*a2+a5*b1*b1*a3),(1*b2*b3*a5+a1*b3*b4*1+a2*b4*b5*a1+a3*b5*1*a2+a4*1*b1*a3+a5*b1*b2*a4),(1*b2*b4*1+a1*b3*b5*a1+a2*b4*1*a2+a3*b5*b1*a3+a4*1*b2*a4+a5*b1*b3*a5),(1*b3*b3*1+a1*b4*b4*a1+a2*b5*b5*a2+a3*1*1*a3+a4*b1*b1*a4+a5*b2*b2*a5),t*y-1,1*1+a1*b1+a2*b2+a3*b3+a4*b4+a5*b5;
ideal G=slimgb(I);
G=std(G);
"RESULT dim",dim(G);
"RESULT length",vdim(G);
poly N=1*1+a1*b1+a2*b2+a3*b3+a4*b4+a5*b5;
"RESULT N2_in_ideal",reduce(N^2-7*t,G);
ideal H=std(G+ideal(N));
"RESULT dim_mod_N",dim(H);
"RESULT length_mod_N",vdim(H);
"RESULT DONE";
quit;
