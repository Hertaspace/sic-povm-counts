ring r=(25,w),(a0,a1,a2,a3,b0,b1,b2,b3),dp;
number tau=w^3;
option(redSB);

proc T(int e) {
  e=e mod 8; if(e<0) {e=e+8;}
  return(tau^e);
}
proc Zf(int u,int v) {
  poly z=0; int s; int j;
  for(s=0;s<4;s++) {
    j=(s+u) mod 4; if(j<0) {j=j+4;}
    z=z+T(u*v+2*v*s)*var(s+1)*var(4+j+1);
  }
  return(z);
}
proc SF(ideal H) {
  ideal E=finduni(H); int i; poly f;
  for(i=1;i<=ncols(E);i++) {
    f=E[i];
    if(deg(f)>0) { if(deg(gcd(f,diff(f,var(i))))>0) {return(0);} }
  }
  return(1);
}
proc PowerNF(poly f,int n,ideal H) {
  poly g=1;
  while(n>0) {
    if(n mod 2==1) {g=reduce(g*f,H);}
    n=n div 2;
    if(n>0) {f=reduce(f*f,H);}
  }
  return(g);
}

proc RadicalData(ideal J) {
  ideal E=finduni(J); ideal U=0; int i; poly f; poly g; int split=1;
  for(i=1;i<=ncols(E);i++) {
    f=E[i];
    if(deg(f)>0) {
      
    g=gcd(f,var(i)^25-var(i));
    if(PowerNF(g,vdim(J),std(ideal(f)))!=0) {split=0;}

      U=U+ideal(g);
    }
  }
  ideal R=std(J+U);
  list result=R,split;
  return(result);
}
ideal I=Zf(0,0)^2,Zf(0,1)*Zf(0,-1),Zf(0,2)*Zf(0,-2),Zf(1,0)*Zf(-1,0),Zf(1,1)*Zf(-1,-1),Zf(1,2)*Zf(-1,-2),Zf(1,3)*Zf(-1,-3),Zf(2,0)*Zf(-2,0),Zf(2,1)*Zf(-2,-1),Zf(2,2)*Zf(-2,-2);
"SINGULAR_VERSION:",system("version");
"ACFW_PHASE_ORDER:",8,tau^8,tau^4;

ideal C=I+ideal(a0-1,b0-1);
ideal H=std(C);
int dh=dim(H); int lh=vdim(H);
"FULL_CHART 0 0 DIM_LENGTH:",dh,lh;
ideal J=std(H+ideal(Zf(0,0)));
int dj=dim(J); int lj=vdim(J);
"TRACE_CHART 0 0 DIM_LENGTH:",dj,lj;
if(dj==0 && lj>0) {
  list RD=RadicalData(J); ideal R=RD[1];
  "REDUCED_CHART 0 0 LENGTH_ALLROOTS:",vdim(R),RD[2];
  "REDUCED_CHART 0 0 SEPARABLE:",SF(R);
  ideal RC=std(R+ideal(0));
"REDUCED_CELL 0 0 LENGTH:",vdim(RC);
kill RC;

  kill RD,R;
}

if(dh==0 && lh>0) {
  // In an Artin algebra of length lh, all local nilpotents have exponent <=lh.
  // These powers retain whole primary components where earlier coordinates
  // have zero residue, giving a disjoint count without discarding nilpotents.
  ideal P=0;

  "FULL_CELL 0 0 LENGTH:",vdim(std(H+P));
  "TRACE_CELL 0 0 LENGTH:",vdim(std(J+P));
  kill P;
}

kill C,H,J,dh,lh,dj,lj;

ideal C=I+ideal(a0-1,b1-1);
ideal H=std(C);
int dh=dim(H); int lh=vdim(H);
"FULL_CHART 0 1 DIM_LENGTH:",dh,lh;
ideal J=std(H+ideal(Zf(0,0)));
