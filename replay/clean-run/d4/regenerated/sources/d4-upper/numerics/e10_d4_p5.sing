P=P+ideal(PowerNF(b1,lh,H));
P=P+ideal(PowerNF(b2,lh,H));

  "FULL_CELL 3 3 LENGTH:",vdim(std(H+P));
  "TRACE_CELL 3 3 LENGTH:",vdim(std(J+P));
  kill P;
}

kill C,H,J,dh,lh,dj,lj;
